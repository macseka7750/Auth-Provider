# ==============================================================================
# DJANGO CORE SETTINGS
# ==============================================================================
# Generate a secret key at: https://djecrety.ir/
SECRET_KEY=your-placeholder-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1


# ==============================================================================
# DATABASE SETTINGS (PostgreSQL Recommended)
# ==============================================================================
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432


# ==============================================================================
# AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
# Time in seconds/minutes for token expiration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=your-at-least-32-character-long-secret-key


# ==============================================================================
# EMAIL SETTINGS (For Password Resets/Verification)
# ==============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com


# ==============================================================================
# REDIS / CELERY (For Scalability & Caching)
# ==============================================================================
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0


# ==============================================================================
# THIRD-PARTY API KEYS
# ==============================================================================
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
