# ==============================================================================
# PROJECT SETTINGS
# ==============================================================================
DEBUG=True
SECRET_KEY=django-insecure-your-very-long-unique-random-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==============================================================================
# DATABASE SETTINGS (PostgreSQL for Docker)
# ==============================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=db
DB_PORT=5432

# ==============================================================================
# JWT SETTINGS (Identity Management)
# ==============================================================================
# Use a different key than SECRET_KEY for better security
JWT_SECRET_KEY=another-random-secret-specifically-for-signing-tokens
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ==============================================================================
# OAUTH2 SETTINGS (Google/GitHub/etc.)
# ==============================================================================
SOCIAL_AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SOCIAL_AUTH_GOOGLE_SECRET=your-google-client-secret

# ==============================================================================
# REDIS / CELERY (Optional: For scaling Background Tasks)
# ==============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
